{
  "schema_version": "1.0",
  "rule_version": "20260809.2",
  "sources": [
    {
      "framework": "owasp",
      "version": "2025",
      "retrieved_at": "2026-08-09",
      "url": "https://owasp.org/Top10/"
    },
    {
      "framework": "owasp_genai",
      "version": "2025",
      "retrieved_at": "2026-08-09",
      "url": "https://genai.owasp.org/"
    },
    {
      "framework": "mitre_attack",
      "version": "Enterprise",
      "retrieved_at": "2026-08-09",
      "url": "https://attack.mitre.org/techniques/enterprise/"
    },
    {
      "framework": "cisa_kev",
      "version": "rolling",
      "retrieved_at": "2026-08-09",
      "url": "https://www.cisa.gov/known-exploited-vulnerabilities-catalog"
    }
  ],
  "rules": [
    {
      "rule_id": "FILE-001",
      "source": "file",
      "severity": 30,
      "reason": "Executable or script created in a user-writable directory",
      "enabled": true,
      "match": {
        "event_type": "file_create",
        "file_extensions": [".exe", ".dll", ".scr", ".ps1"],
        "path_contains_any": ["\\temp\\", "\\appdata\\", "\\downloads\\"]
      },
      "references": [
        {
          "framework": "mitre_attack",
          "external_id": "T1105",
          "url": "https://attack.mitre.org/techniques/T1105/"
        }
      ]
    },
    {
      "rule_id": "PROC-001",
      "source": "behavior",
      "severity": 40,
      "reason": "Office application spawned a script interpreter",
      "enabled": true,
      "match": {
        "event_type": "process_start",
        "process_names": ["powershell.exe", "pwsh.exe", "cmd.exe", "wscript.exe", "mshta.exe"],
        "parent_process_names": ["winword.exe", "excel.exe", "powerpnt.exe", "outlook.exe"]
      },
      "references": [
        {
          "framework": "mitre_attack",
          "external_id": "T1059",
          "url": "https://attack.mitre.org/techniques/T1059/"
        }
      ]
    },
    {
      "rule_id": "PROC-002",
      "source": "behavior",
      "severity": 35,
      "reason": "PowerShell used an encoded or Base64-oriented command",
      "enabled": true,
      "match": {
        "event_type": "process_start",
        "process_names": ["powershell.exe", "pwsh.exe"],
        "command_contains_any": [" -enc ", " -encodedcommand ", "frombase64string"]
      },
      "references": [
        {
          "framework": "mitre_attack",
          "external_id": "T1059.001",
          "url": "https://attack.mitre.org/techniques/T1059/001/"
        }
      ]
    },
    {
      "rule_id": "NET-001",
      "source": "network",
      "severity": 20,
      "reason": "Script interpreter connected to a public IP address",
      "enabled": true,
      "match": {
        "event_type": "network_connect",
        "process_names": ["powershell.exe", "pwsh.exe", "cmd.exe", "wscript.exe", "mshta.exe"],
        "destination_scope": "public"
      },
      "references": [
        {
          "framework": "mitre_attack",
          "external_id": "T1071",
          "url": "https://attack.mitre.org/techniques/T1071/"
        }
      ]
    },
    {
      "rule_id": "SUPPLY-CHAIN-001", "source": "behavior", "severity": 75,
      "reason": "New driver or kernel service requires signature and provenance review", "enabled": true,
      "match": {"event_type": "driver_install"},
      "references": [{"framework": "mitre_attack", "external_id": "T1547.006", "url": "https://attack.mitre.org/techniques/T1547/006/"}]
    },
    {
      "rule_id": "LOLBIN-001", "source": "behavior", "severity": 65,
      "reason": "A living-off-the-land binary used a remote or script payload", "enabled": true,
      "match": {"event_type": "process_start", "process_names": ["mshta.exe", "rundll32.exe", "regsvr32.exe", "certutil.exe"], "command_contains_any": ["http://", "https://", "javascript:", "scrobj.dll"]},
      "references": [{"framework": "mitre_attack", "external_id": "T1218", "url": "https://attack.mitre.org/techniques/T1218/"}]
    },
    {
      "rule_id": "RANSOM-001", "source": "behavior", "severity": 90,
      "reason": "Command attempted recovery inhibition or mass shadow-copy removal", "enabled": true,
      "match": {"event_type": "process_start", "command_contains_any": ["vssadmin delete shadows", "wmic shadowcopy delete", "bcdedit /set recoveryenabled no"]},
      "references": [{"framework": "mitre_attack", "external_id": "T1490", "url": "https://attack.mitre.org/techniques/T1490/"}]
    },
    {
      "rule_id": "INFOSTEALER-001", "source": "behavior", "severity": 80,
      "reason": "PowerShell script referenced browser credential stores", "enabled": true,
      "match": {"event_type": "powershell_script", "field_contains_any": {"command_line": ["login data", "local state", "cookies"]}},
      "references": [{"framework": "mitre_attack", "external_id": "T1555.003", "url": "https://attack.mitre.org/techniques/T1555/003/"}]
    },
    {
      "rule_id": "WORM-001", "source": "behavior", "severity": 85,
      "reason": "Remote service creation indicates lateral propagation", "enabled": true,
      "match": {"event_type": "service_install", "field_contains_any": {"details": ["admin$", "\\\\"]}},
      "references": [{"framework": "mitre_attack", "external_id": "T1021.002", "url": "https://attack.mitre.org/techniques/T1021/002/"}]
    }
  ]
}
